{
  "name": "calendar-earnings-app",
  "version": "1.0.0",
  "description": "Fetch Google Calendar events and calculate earnings from keyword mapping (effective-date pricing). Runs locally so it can be verified end-to-end.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "auth": "node dist/run-auth.js",
    "full-load": "node dist/index.js full-load",
    "incremental": "node dist/index.js incremental",
    "earnings-only": "node dist/index.js earnings-only",
    "start": "npm run build && node dist/index.js",
    "verify": "node dist/verify.js",
    "setup": "npm run build && node dist/setup.js",
    "dev": "npm run build && node dist/setup.js && node dist/server.js",
    "serve": "node dist/server.js"
  },
  "bin": {
    "calendar-earnings": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
