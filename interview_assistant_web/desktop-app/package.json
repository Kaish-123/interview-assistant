{
  "name": "interview-assistant",
  "version": "1.0.0",
  "description": "AI-powered Interview Assistant with real-time transcription",
  "main": "main.js",
  "author": "TechYera",
  "license": "MIT",
  "homepage": "https://techyera.co",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\" \"wait-on http://localhost:3000 && electron .\"",
    "start:backend": "cd ../backend && python3 main.py",
    "start:frontend": "cd ../frontend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend && electron-builder",
    "build:frontend": "cd ../frontend && npm run build",
    "build:backend": "cd ../backend && pyinstaller --onedir --name backend main.py",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "electron-store": "^8.1.0",
    "fix-path": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "co.techyera.interview-assistant",
    "productName": "Interview Assistant",
    "copyright": "Copyright © 2024 TechYera",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/.next",
        "to": "frontend/.next",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/public",
        "to": "frontend/public",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/node_modules",
        "to": "frontend/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/package.json",
        "to": "frontend/package.json"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Interview Assistant",
      "icon": "resources/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": ["AppImage", "deb"],
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "your-github-username",
      "repo": "interview-assistant"
    }
  }
}


