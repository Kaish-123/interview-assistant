# Interview Copilot — environment template (Phase 1 Milestone 1)
# Copy to repo root `.env` or `interview_copilot/.env`
#   cp interview_copilot/env.example .env

# Required for STT / LLM (milestones 3+)
OPENAI_API_KEY=

# Optional overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=3
OPENAI_MAX_OUTPUT_TOKENS=1600
ANSWER_MODE=default
OPTIMIZATION_MODE=false
IMAGE_DETAIL_LEVEL=low
MAX_ROUNDS_FOR_MODEL=4
SUMMARY_THRESHOLD_ROUNDS=5

# STT — OpenAI transcribe (live streaming + file commit)
# gpt-4o-mini-transcribe is faster/more accurate than whisper-1 for interviews.
WHISPER_MODEL=gpt-4o-mini-transcribe
STT_LIVE_MODEL=gpt-4o-mini-transcribe
WHISPER_MAX_RETRIES=3
WHISPER_RETRY_BACKOFF_SECS=2.0
# Leave empty to use DEFAULT_LANGUAGE, or set e.g. en / hi / auto
WHISPER_LANGUAGE=

# Audio — Live overlay hears Zoom/Meet/Teams/YouTube (not just the mic)
# macOS: install BlackHole, Multi-Output Device (Speakers + BlackHole), set as system output
# Windows: WASAPI loopback is used automatically; VB-Cable optional
AUDIO_INPUT_MODE=internal
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK=1024
BLACKHOLE_DEVICE=BlackHole
VB_CABLE_DEVICE=CABLE Output

# VAD (Live auto-answer — Phase 3)
VAD_SPEECH_RMS=0.012
VAD_SILENCE_SECS=1.8
VAD_MIN_RECORD_SECS=1.2
VAD_ONSET_CHUNKS=3

DEFAULT_LANGUAGE=en

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Web companion (apps/web) — landing + login
# AUTH_REQUIRED=true gates /app and APIs until the user signs in.
AUTH_SECRET=change-me-in-production
AUTH_REQUIRED=false
AUTH_PUBLIC_URL=http://127.0.0.1:8787
AUTH_DEV_SHOW_CODE=true
WEB_HOST=127.0.0.1
WEB_PORT=8787

# Google OAuth (optional). Authorized redirect URI:
#   {AUTH_PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email login codes. If SMTP is empty, the code is printed to the server log.
# With AUTH_DEV_SHOW_CODE=true the code is also returned in the API (localhost only — turn off in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Interview Copilot <noreply@localhost>
